ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave
JWT_SECRET=cadena-larga-aleatoria
# Supabase > Project Settings > API: Project URL y una Secret key (sb_secret_...) o la service_role legacy.
# Nunca use la Publishable key aquí, y nunca exponga la Secret key en el frontend.
SUPABASE_URL=https://su-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Correo (opcional): sin estas variables las solicitudes igual se guardan en el panel.
RESEND_API_KEY=re_...
CONTACT_TO=correo-de-epg@ejemplo.com
# Remitente: sin dominio verificado en Resend use el de prueba (solo entrega al correo de su cuenta de Resend).
RESEND_FROM=EPG Web <onboarding@resend.dev>
# true solo con dominio verificado: envía al solicitante un "Recibimos su solicitud".
RESEND_CONFIRM=false
PORT=3001
